// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Pegawai {
  id                      Int                      @id @default(autoincrement())
  nip_pegawai             String
  nama_pegawai            String
  tanggal_lahir           DateTime
  jenis_kelamin           String
  alamat_pegawai          String
  nomor_telepon_pegawai   String
  email_pegawai           String
  jabatan_pegawai         String
  is_aktif                Boolean
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  deleted_at              DateTime?
  mutasiStok              MutasiStok[]
  LoginPemakai            LoginPemakai?
  pembayaranPembelian     PembayaranPembelian[]
  mutasiStokVariants      MutasiStokVariant[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderDetails    PurchaseOrderDetail[]
  penerimaanBarangs       PenerimaanBarang[]
  penerimaanBarangDetails PenerimaanBarangDetail[]

  @@map("pegawai_m")
}

model LoginPemakai {
  id                Int                 @id @default(autoincrement())
  username          String              @unique
  password          String
  last_login        DateTime?
  role              String
  is_aktif          Boolean
  email             String
  verified          Boolean             @default(false)
  pegawai_id        Int?                @unique
  pegawai           Pegawai?            @relation(fields: [pegawai_id], references: [id])
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  deleted_at        DateTime?
  EmailVerification EmailVerification[]

  @@map("loginpemakai_k")
}

model EmailVerification {
  id              Int           @id @default(autoincrement())
  token           String        @unique
  loginpemakai_id Int?
  expired_at      DateTime
  created_at      DateTime      @default(now())
  loginPemakai    LoginPemakai? @relation(fields: [loginpemakai_id], references: [id], onDelete: Cascade)

  @@map("emailverification_t")
}

model Satuan {
  id                 Int                 @id @default(autoincrement())
  kode_satuan        String
  nama_satuan        String
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  deleted_at         DateTime?
  Produk             Produk[]
  mutasiStok         MutasiStok[]
  mutasiStokVariants MutasiStokVariant[]
  produkVariants     ProdukVariant[]

  @@map("satuanproduk_m")
}

model Stok {
  id            Int       @id @default(autoincrement())
  produk_id     Int?      @unique
  produk        Produk?   @relation(fields: [produk_id], references: [id])
  jumlah_stok   Int
  minimal_stok  Int
  maksimal_stok Int
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("stokproduk_m")
}

model MutasiStok {
  id                 Int       @id @default(autoincrement())
  produk_id          Int?
  produk             Produk?   @relation(fields: [produk_id], references: [id])
  tipe_mutasi        String
  jumlah_mutasi      Int
  keterangan_mutasi  String
  pegawai_id         Int?
  pegawai            Pegawai?  @relation(fields: [pegawai_id], references: [id])
  satuan_produk_id   Int?
  satuan_produk      Satuan?   @relation(fields: [satuan_produk_id], references: [id])
  tanggal_kadaluarsa DateTime?
  tanggal_mutasi     DateTime
  nomor_mutasi       String
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  @@map("mutasistok_m")
}

model MutasiStokVariant {
  id                 Int            @id @default(autoincrement())
  produk_variant_id  Int?
  produkVariant      ProdukVariant? @relation(fields: [produk_variant_id], references: [id])
  tipe_mutasi        String
  jumlah_mutasi      Int
  keterangan_mutasi  String
  pegawai_id         Int?
  pegawai            Pegawai?       @relation(fields: [pegawai_id], references: [id])
  satuan_produk_id   Int?
  satuan_produk      Satuan?        @relation(fields: [satuan_produk_id], references: [id])
  tanggal_kadaluarsa DateTime?
  tanggal_mutasi     DateTime
  nomor_mutasi       String
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  deleted_at         DateTime?

  @@map("mutasistokvariant_m")
}

model Kategori {
  id            Int       @id @default(autoincrement())
  kode_kategori String
  nama_kategori String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  Produk        Produk[]

  @@map("kategoriproduk_m")
}

model Supplier {
  id                     Int             @id @default(autoincrement())
  kode_supplier          String
  nama_supplier          String
  alamat_supplier        String
  nomor_telepon_supplier String
  is_aktif               Boolean
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  deleted_at             DateTime?
  Produk                 Produk[]
  Pembelian              Pembelian[]
  purchaseOrders         PurchaseOrder[]

  @@map("supplier_m")
}

model Harga {
  id         Int       @id @default(autoincrement())
  produk_id  Int?
  produk     Produk?   @relation(fields: [produk_id], references: [id])
  harga_beli Float
  harga_jual Float
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("hargaproduk_m")
}

model Produk {
  id                   Int                    @id @default(autoincrement())
  kategori_id          Int?
  kategori             Kategori?              @relation(fields: [kategori_id], references: [id])
  satuan_produk_id     Int?
  satuan               Satuan?                @relation(fields: [satuan_produk_id], references: [id])
  supplier_id          Int?
  supplier             Supplier?              @relation(fields: [supplier_id], references: [id])
  kode_produk          String
  nama_produk          String
  deskripsi_produk     String?
  gambar_produk        String?
  is_aktif             Boolean
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  deleted_at           DateTime?
  mutasiStok           MutasiStok[]
  Stok                 Stok[]
  Harga                Harga[]
  DetailPenjualan      DetailPenjualan[]
  DetailPembelian      DetailPembelian[]
  DetailReturPembelian DetailReturPembelian[]
  produkVariants       ProdukVariant[]

  @@map("produk_m")
}

model Penjualan {
  id                Int               @id @default(autoincrement())
  nomor_penjualan   String
  tanggal_penjualan DateTime
  status_penjualan  String
  total_harga       Float
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  deleted_at        DateTime?
  DetailPenjualan   DetailPenjualan[]
  Pembayaran        Pembayaran[]

  @@map("penjualan_t")
}

model DetailPenjualan {
  id            Int        @id @default(autoincrement())
  penjualan_id  Int?
  penjualan     Penjualan? @relation(fields: [penjualan_id], references: [id])
  produk_id     Int?
  produk        Produk?    @relation(fields: [produk_id], references: [id])
  harga_satuan  Float
  jumlah_produk Int
  harga_produk  Float
  total_harga   Float
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  deleted_at    DateTime?

  @@map("detailpenjualan_t")
}

model Pembayaran {
  id              Int       @id @default(autoincrement())
  penjualan_id    Int
  penjualan       Penjualan @relation(fields: [penjualan_id], references: [id])
  tanggal_bayar   DateTime  @default(now())
  jumlah_bayar    Float
  metode_bayar    String
  nomor_referensi String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  @@map("pembayaran_t")
}

model PembayaranPembelian {
  id               Int       @id @default(autoincrement())
  pembelian_id     Int
  pembelian        Pembelian @relation(fields: [pembelian_id], references: [id])
  nomor_pembayaran String?
  tanggal_bayar    DateTime
  jumlah_bayar     Float
  metode_bayar     String
  nomor_referensi  String?
  nomor_rekening   String?
  pegawai_id       Int
  pegawai          Pegawai   @relation(fields: [pegawai_id], references: [id])
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  @@map("pembayaranpembelian_t")
}

model Pembelian {
  id                  Int                   @id @default(autoincrement())
  nomor_pembelian     String
  nomor_faktur        String
  tanggal_pembelian   DateTime
  supplier_id         Int?
  supplier            Supplier?             @relation(fields: [supplier_id], references: [id])
  status_pembelian    String
  total_harga         Float
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  deleted_at          DateTime?
  DetailPembelian     DetailPembelian[]
  ReturPembelian      ReturPembelian[]
  pembayaranPembelian PembayaranPembelian[]

  @@map("pembelian_t")
}

model DetailPembelian {
  id            Int        @id @default(autoincrement())
  pembelian_id  Int?
  pembelian     Pembelian? @relation(fields: [pembelian_id], references: [id])
  produk_id     Int?
  produk        Produk?    @relation(fields: [produk_id], references: [id])
  harga_satuan  Float
  jumlah_produk Int
  harga_produk  Float
  total_harga   Float
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  deleted_at    DateTime?

  @@map("detailpembelian_t")
}

model ReturPembelian {
  id                   Int                    @id @default(autoincrement())
  nomor_retur          String
  pembelian_id         Int?
  pembelian            Pembelian?             @relation(fields: [pembelian_id], references: [id])
  tanggal_retur        DateTime
  total_harga          Float
  keterangan_retur     String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  deleted_at           DateTime?
  DetailReturPembelian DetailReturPembelian[]

  @@map("returpembelian_t")
}

model DetailReturPembelian {
  id                 Int             @id @default(autoincrement())
  retur_pembelian_id Int?
  retur_pembelian    ReturPembelian? @relation(fields: [retur_pembelian_id], references: [id])
  produk_id          Int?
  produk             Produk?         @relation(fields: [produk_id], references: [id])
  harga_satuan       Float
  jumlah_produk      Int
  harga_produk       Float
  total_harga        Float
  keterangan_retur   String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  deleted_at         DateTime?

  @@map("detailreturpembelian_t")
}

model ProdukVariant {
  id               Int       @id @default(autoincrement())
  produk_id        Int
  sku              String    @unique
  ukuran           String
  warna            String?
  satuan_produk_id Int?
  satuan           Satuan?   @relation(fields: [satuan_produk_id], references: [id])
  is_aktif         Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  produk                  Produk                   @relation(fields: [produk_id], references: [id])
  stok                    StokVariant?
  mutasiStokVariants      MutasiStokVariant[]
  purchaseOrderDetails    PurchaseOrderDetail[]
  penerimaanBarangDetails PenerimaanBarangDetail[]

  @@map("produkvariant_m")
}

model StokVariant {
  id                Int       @id @default(autoincrement())
  produk_variant_id Int       @unique
  jumlah_stok       Int
  minimal_stok      Int
  maksimal_stok     Int
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  variant ProdukVariant @relation(fields: [produk_variant_id], references: [id])

  @@map("stokvariant_m")
}

model PurchaseOrder {
  id       Int    @id @default(autoincrement())
  nomor_po String @unique

  supplier_id Int
  supplier    Supplier @relation(fields: [supplier_id], references: [id])

  pegawai_id Int
  pegawai    Pegawai @relation(fields: [pegawai_id], references: [id])

  tanggal_po  DateTime
  status_po   String
  total_harga Float

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  details    PurchaseOrderDetail[]
  penerimaan PenerimaanBarang[]

  @@map("purchaseorder_t")
}

model PurchaseOrderDetail {
  id Int @id @default(autoincrement())

  purchase_order_id Int
  purchaseOrder     PurchaseOrder @relation(fields: [purchase_order_id], references: [id])

  produk_variant_id Int
  produkVariant     ProdukVariant @relation(fields: [produk_variant_id], references: [id])

  harga_satuan  Float
  jumlah_produk Int
  qty_diterima  Int   @default(0)
  total_harga   Float

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  pegawai                 Pegawai?                 @relation(fields: [pegawai_id], references: [id])
  pegawai_id              Int?
  penerimaanBarangDetails PenerimaanBarangDetail[]

  @@map("purchaseorderdetail_t")
}

model PenerimaanBarang {
  id Int @id @default(autoincrement())

  purchase_order_id Int
  purchaseOrder     PurchaseOrder @relation(fields: [purchase_order_id], references: [id])

  pegawai_id Int
  pegawai    Pegawai @relation(fields: [pegawai_id], references: [id])

  nomor_penerimaan   String   @unique
  tanggal_penerimaan DateTime
  status_penerimaan  String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  details          PenerimaanBarangDetail[]
  returPenerimaans ReturPenerimaan[]

  @@map("penerimaanbarang_t")
}

model PenerimaanBarangDetail {
  id Int @id @default(autoincrement())

  penerimaan_barang_id Int
  penerimaanBarang     PenerimaanBarang @relation(fields: [penerimaan_barang_id], references: [id])

  purchase_order_detail_id Int
  purchaseOrderDetail      PurchaseOrderDetail @relation(fields: [purchase_order_detail_id], references: [id])

  produk_variant_id Int
  produkVariant     ProdukVariant @relation(fields: [produk_variant_id], references: [id])

  harga_satuan  Float
  jumlah_produk Int
  total_harga   Float
  qty_retur     Int   @default(0)

  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  deleted_at             DateTime?
  pegawai                Pegawai?                @relation(fields: [pegawai_id], references: [id])
  pegawai_id             Int?
  detailReturPenerimaans DetailReturPenerimaan[]

  @@map("penerimaanbarangdetail_t")
}

model ReturPenerimaan {
  id          Int    @id @default(autoincrement())
  nomor_retur String @unique

  penerimaanbarang_id Int
  penerimaan          PenerimaanBarang @relation(fields: [penerimaanbarang_id], references: [id])

  tanggal_retur DateTime
  total_harga   Float
  alasan_retur  String?
  status        String

  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  deleted_at             DateTime?
  detailReturPenerimaans DetailReturPenerimaan[]

  @@map("returpenerimaan_t")
}

model DetailReturPenerimaan {
  id Int @id @default(autoincrement())

  returpenerimaan_id Int
  returPenerimaan    ReturPenerimaan @relation(fields: [returpenerimaan_id], references: [id])

  penerimaanbarangdetail_id Int
  penerimaanBarangDetail    PenerimaanBarangDetail @relation(fields: [penerimaanbarangdetail_id], references: [id])

  harga_satuan     Float
  jumlah_produk    Int
  total_harga      Float
  keterangan_retur String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  @@map("detailreturpenerimaan_t")
}
